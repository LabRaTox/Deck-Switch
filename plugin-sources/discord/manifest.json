{
  "id": "discord",
  "name": "Discord",
  "version": "1.0.1",
  "type": "action",
  "author": "LabRaTox",
  "category": "engagement",
  "accent": "#5865f2",
  "description": {
    "de": "Steuert den laufenden Discord-Client: Mute, Deafen, Sprach- und Textkanäle.",
    "en": "Controls the running Discord client: mute, deafen, voice and text channels."
  },
  "changelog": {
    "de": "1.0.1 — Nur innen drin: Das Plugin holt seine Hilfsdatei jetzt relativ. Damit können zwei Plugins Dateien gleich benennen, ohne sich gegenseitig auszubremsen.",
    "en": "1.0.1 — Under the hood only: the plugin now imports its helper file relatively, so two plugins can name files alike without getting in each other's way."
  },
  "license": "MIT",
  "support": "https://github.com/LabRaTox/Deck-Switch",
  "icon": "icon.png",
  "entry": "plugin.py",
  "class": "DiscordPlugin",
  "config_schema": [
    {
      "key": "client_id",
      "type": "text",
      "label": {
        "de": "Application-ID",
        "en": "Application ID"
      },
      "help": {
        "de": "Aus dem Discord Developer Portal (eigene Application anlegen).",
        "en": "From the Discord Developer Portal (create your own application)."
      }
    },
    {
      "key": "client_secret",
      "type": "password",
      "label": {
        "de": "Client-Secret",
        "en": "Client secret"
      },
      "help": {
        "de": "Wird nur einmal für den Token-Tausch gebraucht.",
        "en": "Only needed once to exchange the authorization code."
      }
    },
    {
      "key": "redirect_uri",
      "type": "text",
      "label": {
        "de": "Redirect-URI",
        "en": "Redirect URI"
      },
      "default": "http://localhost",
      "help": {
        "de": "Muss im Developer Portal unter OAuth2 identisch eingetragen sein.",
        "en": "Must be registered identically under OAuth2 in the developer portal."
      }
    },
    {
      "key": "auto_connect",
      "type": "bool",
      "label": {
        "de": "Automatisch verbinden",
        "en": "Connect automatically"
      },
      "default": true
    }
  ],
  "actions": [
    {
      "id": "mute",
      "name": {
        "de": "Mute",
        "en": "Mute"
      },
      "description": {
        "de": "Schaltet das eigene Mikrofon in Discord stumm.",
        "en": "Mutes your own microphone in Discord."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "microphone",
      "default_label": "Mute",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Offen",
            "en": "Live"
          },
          "default_icon": "microphone"
        },
        {
          "id": "muted",
          "name": {
            "de": "Stumm",
            "en": "Muted"
          },
          "default_icon": "microphone-off"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verbunden",
            "en": "Disconnected"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "mode",
          "type": "select",
          "label": {
            "de": "Verhalten",
            "en": "Behaviour"
          },
          "default": "toggle",
          "options": [
            {
              "value": "toggle",
              "label": {
                "de": "Umschalten",
                "en": "Toggle"
              }
            },
            {
              "value": "push_to_talk",
              "label": {
                "de": "Push-to-Talk",
                "en": "Push to talk"
              }
            },
            {
              "value": "push_to_mute",
              "label": {
                "de": "Push-to-Mute",
                "en": "Push to mute"
              }
            }
          ],
          "help": {
            "de": "Push-to-Talk öffnet das Mikrofon nur solange gedrückt, Push-to-Mute schließt es nur solange gedrückt. Beides braucht eine Taste — auf einem Dial wird immer umgeschaltet.",
            "en": "Push-to-talk opens the microphone only while held, push-to-mute closes it only while held. Both need a key — a dial always toggles."
          }
        }
      ]
    },
    {
      "id": "deafen",
      "name": {
        "de": "Deafen",
        "en": "Deafen"
      },
      "description": {
        "de": "Schaltet Ein- und Ausgabe in Discord stumm.",
        "en": "Mutes both input and output in Discord."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "headphones",
      "default_label": "Deafen",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Normal",
            "en": "Normal"
          },
          "default_icon": "headphones"
        },
        {
          "id": "deafened",
          "name": {
            "de": "Taub",
            "en": "Deafened"
          },
          "default_icon": "headphones-off"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verbunden",
            "en": "Disconnected"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "channel",
      "name": {
        "de": "Kanal wechseln",
        "en": "Switch channel"
      },
      "description": {
        "de": "Wechselt in einen bestimmten Sprachkanal.",
        "en": "Joins a specific voice channel."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "microphone-2",
      "states": [
        {
          "id": "active",
          "name": {
            "de": "Verbunden",
            "en": "Connected"
          }
        },
        {
          "id": "inactive",
          "name": {
            "de": "Nicht verbunden",
            "en": "Not connected"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Kein Discord",
            "en": "No Discord"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "channel_id",
          "type": "select",
          "label": {
            "de": "Sprachkanal",
            "en": "Voice channel"
          },
          "options_source": "voice_channels"
        },
        {
          "key": "guild_icon",
          "type": "bool",
          "label": {
            "de": "Serverlogo als Icon",
            "en": "Server logo as icon"
          },
          "default": true,
          "help": {
            "de": "Zeigt das Logo des Discord-Servers, solange kein eigenes Icon gewählt ist.",
            "en": "Shows the Discord server's logo unless a custom icon is set."
          }
        }
      ]
    },
    {
      "id": "leave",
      "name": {
        "de": "Kanal verlassen",
        "en": "Leave channel"
      },
      "description": {
        "de": "Verlässt den aktuellen Sprachkanal.",
        "en": "Leaves the current voice channel."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "phone-off",
      "settings_schema": []
    },
    {
      "id": "text_channel",
      "name": {
        "de": "Textkanal öffnen",
        "en": "Open text channel"
      },
      "description": {
        "de": "Springt im Discord-Fenster zu einem bestimmten Textkanal.",
        "en": "Jumps to a specific text channel in the Discord window."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "message",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Normal",
            "en": "Normal"
          },
          "default_icon": "message"
        },
        {
          "id": "offline",
          "name": {
            "de": "Kein Discord",
            "en": "No Discord"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "channel_id",
          "type": "select",
          "label": {
            "de": "Textkanal",
            "en": "Text channel"
          },
          "options_source": "text_channels",
          "help": {
            "de": "Discord kennt keinen Weg, den gerade offenen Textkanal abzufragen — die Taste zeigt deshalb keinen Aktiv-Zustand.",
            "en": "Discord offers no way to query the currently open text channel, so this key has no active state."
          }
        },
        {
          "key": "guild_icon",
          "type": "bool",
          "label": {
            "de": "Serverlogo als Icon",
            "en": "Server logo as icon"
          },
          "default": true,
          "help": {
            "de": "Zeigt das Logo des Discord-Servers, solange kein eigenes Icon gewählt ist.",
            "en": "Shows the Discord server's logo unless a custom icon is set."
          }
        }
      ]
    },
    {
      "id": "input_volume",
      "name": {
        "de": "Mikrofonpegel",
        "en": "Input volume"
      },
      "description": {
        "de": "Regelt den Discord-Eingangspegel.",
        "en": "Adjusts the Discord input level."
      },
      "inputs": [
        "dial"
      ],
      "default_icon": "adjustments",
      "settings_schema": [
        {
          "key": "step",
          "type": "number",
          "label": {
            "de": "Schrittweite (%)",
            "en": "Step size (%)"
          },
          "default": 5,
          "min": 1,
          "max": 25
        }
      ]
    }
  ],
  "screenshots": [
    "screenshots/aktionen.png",
    "screenshots/zustaende.png"
  ]
}
