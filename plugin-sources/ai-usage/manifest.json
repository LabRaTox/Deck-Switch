{
  "id": "ai-usage",
  "name": {
    "de": "KI-Nutzung",
    "en": "AI Usage"
  },
  "version": "1.1.0",
  "min_app_version": "1.4.0",
  "type": "action",
  "author": "LabRaTox",
  "category": "monitoring",
  "accent": "#8b5cf6",
  "description": {
    "de": "Session-, Wochen- und Guthaben-Limits von Claude, Codex und weiteren KI-Diensten auf Tasten und Dials. Die Daten kommen von CodexBar, einem freien Programm (MIT-Lizenz), das die Nutzung bei den Anbietern abfragt und als Dienst auf deinem Rechner läuft. Die Zugangsdaten bleiben dabei auf dem Rechner. CodexBar unterstützt 110 Anbieter. Ohne CodexBar zeigt das Plugin nur Claude, direkt abgefragt. CodexBar gibt es hier: https://github.com/steipete/CodexBar",
    "en": "Session, weekly and credit limits of Claude, Codex and other AI services on keys and dials. The data comes from CodexBar, a free program (MIT licence) that queries usage from the providers and runs as a service on your machine. Your credentials stay on the machine. CodexBar supports 110 providers. Without CodexBar the plugin shows only Claude, queried directly. Get CodexBar here: https://github.com/steipete/CodexBar"
  },
  "summary": {
    "de": "Session-, Wochen- und Guthaben-Limits von Claude, Codex und weiteren KI-Diensten auf Tasten und Dials.",
    "en": "Session, weekly and credit limits of Claude, Codex and other AI services on keys and dials."
  },
  "changelog": {
    "de": "Eine unerwartete Antwort von CodexBar beendet die Abfrage nicht mehr. Vorher blieben die Tasten danach bis zum Neustart stehen. Die Texte des Plugins folgen jetzt der eingestellten Sprache. Braucht DECK//SWITCH 1.4.0 oder neuer.",
    "en": "An unexpected reply from CodexBar no longer stops the polling. Before, the keys froze until the next restart. The plugin's texts now follow the language setting. Needs DECK//SWITCH 1.4.0 or newer."
  },
  "license": "MIT",
  "support": "https://github.com/LabRaTox/Deck-Switch",
  "icon": "icon.png",
  "entry": "plugin.py",
  "class": "AIUsagePlugin",
  "config_schema": [
    {
      "key": "url",
      "type": "text",
      "label": {
        "de": "CodexBar-Adresse",
        "en": "CodexBar address"
      },
      "default": "http://127.0.0.1:8790",
      "placeholder": "http://127.0.0.1:8790",
      "help": {
        "de": "Wo `codexbar serve` läuft. Nur Loopback, Zugangsdaten verlassen den Rechner nicht.",
        "en": "Where `codexbar serve` runs. Loopback only, credentials never leave the machine."
      }
    },
    {
      "key": "token_file",
      "type": "text",
      "label": {
        "de": "Token-Datei",
        "en": "Token file"
      },
      "default": "~/.config/codexbar/dashboard.env",
      "placeholder": "~/.config/codexbar/dashboard.env",
      "help": {
        "de": "Datei mit der Zeile CODEXBAR_DASHBOARD_TOKEN=…, also dieselbe Datei, die der CodexBar-Dienst liest. Der Token selbst wird nirgends gespeichert.",
        "en": "File with the line CODEXBAR_DASHBOARD_TOKEN=…, the same file the CodexBar service reads. The token itself is never stored."
      }
    },
    {
      "key": "refresh_seconds",
      "type": "number",
      "label": {
        "de": "Aktualisierung (Sekunden)",
        "en": "Refresh (seconds)"
      },
      "default": 60,
      "min": 30,
      "max": 3600
    },
    {
      "key": "warn_pct",
      "type": "number",
      "label": {
        "de": "Warnung ab %",
        "en": "Warning from %"
      },
      "default": 70,
      "min": 1,
      "max": 100
    },
    {
      "key": "crit_pct",
      "type": "number",
      "label": {
        "de": "Kritisch ab %",
        "en": "Critical from %"
      },
      "default": 90,
      "min": 1,
      "max": 100
    },
    {
      "key": "color_ok",
      "type": "color",
      "label": {
        "de": "Farbe normal",
        "en": "Colour normal"
      },
      "default": "#22c55e"
    },
    {
      "key": "color_warn",
      "type": "color",
      "label": {
        "de": "Farbe Warnung",
        "en": "Colour warning"
      },
      "default": "#eab308"
    },
    {
      "key": "color_crit",
      "type": "color",
      "label": {
        "de": "Farbe kritisch",
        "en": "Colour critical"
      },
      "default": "#ef4444"
    },
    {
      "key": "claude_fallback",
      "type": "bool",
      "label": {
        "de": "Claude direkt, wenn CodexBar fehlt",
        "en": "Claude directly when CodexBar is missing"
      },
      "default": true,
      "help": {
        "de": "Liest den Login aus ~/.claude/.credentials.json. Er wird nur gelesen und nie erneuert.",
        "en": "Reads the login from ~/.claude/.credentials.json. It is only read, never refreshed."
      }
    },
    {
      "key": "fetch_pace",
      "type": "bool",
      "label": {
        "de": "Prognose holen",
        "en": "Fetch forecast"
      },
      "default": true,
      "help": {
        "de": "„Reicht bis Reset“ oder „leer in 2 h 30 m“, von CodexBar. Höchstens alle fünf Minuten.",
        "en": "“Lasts until reset” or “empty in 2h 30m”, from CodexBar. At most every five minutes."
      }
    },
    {
      "key": "notify",
      "type": "bool",
      "label": {
        "de": "Desktop-Benachrichtigung ab kritisch",
        "en": "Desktop notification when critical"
      },
      "default": false,
      "help": {
        "de": "Einmal je Fenster, wenn es die kritische Schwelle überschreitet.",
        "en": "Once per window when it crosses the critical threshold."
      }
    }
  ],
