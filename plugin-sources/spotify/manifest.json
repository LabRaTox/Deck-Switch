{
  "id": "spotify",
  "name": "Spotify",
  "version": "1.1.0",
  "type": "action",
  "author": "LabRaTox",
  "category": "music",
  "accent": "#1db954",
  "description": {
    "de": "Musiksteuerung ohne Fensterwechsel: abspielen, pausieren, Titel überspringen, Shuffle, Wiederholung und Lautstärke — direkt vom Deck.",
    "en": "Music control without switching windows: play, pause, skip tracks, shuffle, repeat and volume — straight from the deck."
  },
  "changelog": {
    "de": "1.1.0 — Playlists direkt starten, Lautstärke wahlweise über PipeWire, Albumbild als Hintergrund am Dial.",
    "en": "1.1.0 — start playlists directly, volume via PipeWire if you prefer, album art as dial background."
  },
  "license": "MIT",
  "support": "https://github.com/LabRaTox/Deck-Switch",
  "icon": "icon.png",
  "screenshots": [
    "screenshots/aktionen.png",
    "screenshots/zustaende.png"
  ],
  "entry": "plugin.py",
  "class": "SpotifyPlugin",
  "config_schema": [
    {
      "key": "player",
      "type": "select",
      "label": {
        "de": "Player",
        "en": "Player"
      },
      "default": "spotify",
      "options_source": "players",
      "help": {
        "de": "Standard ist Spotify. Es funktioniert aber jeder Player, der MPRIS unterstützt.",
        "en": "Defaults to Spotify. Any player supporting MPRIS works too."
      }
    },
    {
      "key": "volume_via_pipewire",
      "type": "bool",
      "label": {
        "de": "Lautstärke über PipeWire regeln",
        "en": "Adjust volume via PipeWire"
      },
      "default": true,
      "help": {
        "de": "Zuverlässiger als die spielereigene Lautstärke, die nicht jeder Player anbietet.",
        "en": "More reliable than the player's own volume, which not every player exposes."
      }
    }
  ],
  "actions": [
    {
      "id": "play_pause",
      "name": {
        "de": "Wiedergabe",
        "en": "Playback"
      },
      "description": {
        "de": "Startet oder pausiert die Wiedergabe.",
        "en": "Play, pause, or toggle playback."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-play",
      "default_label": "",
      "states": [
        {
          "id": "playing",
          "name": {
            "de": "Läuft",
            "en": "Playing"
          },
          "default_icon": "player-pause"
        },
        {
          "id": "paused",
          "name": {
            "de": "Pausiert",
            "en": "Paused"
          },
          "default_icon": "player-play"
        },
        {
          "id": "stopped",
          "name": {
            "de": "Gestoppt",
            "en": "Stopped"
          },
          "default_icon": "player-play"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "show_track",
          "type": "select",
          "label": {
            "de": "Anzeige",
            "en": "Display"
          },
          "default": "title",
          "options": [
            {
              "value": "none",
              "label": {
                "de": "Nur Icon",
                "en": "Icon only"
              }
            },
            {
              "value": "title",
              "label": {
                "de": "Titel",
                "en": "Title"
              }
            },
            {
              "value": "artist",
              "label": {
                "de": "Künstler",
                "en": "Artist"
              }
            },
            {
              "value": "both",
              "label": {
                "de": "Titel und Künstler",
                "en": "Title and artist"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "next",
      "name": {
        "de": "Nächster Titel",
        "en": "Next track"
      },
      "description": {
        "de": "Springt zum nächsten Titel.",
        "en": "Skip to the next track."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-track-next",
      "states": [
        {
          "id": "ready",
          "name": {
            "de": "Bereit",
            "en": "Ready"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "previous",
      "name": {
        "de": "Vorheriger Titel",
        "en": "Previous track"
      },
      "description": {
        "de": "Springt zum vorherigen Titel.",
        "en": "Skip to the previous track."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-track-prev",
      "states": [
        {
          "id": "ready",
          "name": {
            "de": "Bereit",
            "en": "Ready"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "playlist",
      "name": {
        "de": "Playlist starten",
        "en": "Start playlist"
      },
      "description": {
        "de": "Startet eine bestimmte Playlist, ein Album oder einen Titel.",
        "en": "Starts a specific playlist, album or track."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "playlist",
      "default_label": "Playlist",
      "states": [
        {
          "id": "ready",
          "name": {
            "de": "Bereit",
            "en": "Ready"
          },
          "default_icon": "playlist"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "uri",
          "type": "text",
          "label": {
            "de": "Playlist-Link",
            "en": "Playlist link"
          },
          "placeholder": {
            "de": "https://open.spotify.com/playlist/…",
            "en": "https://open.spotify.com/playlist/…"
          },
          "help": {
            "de": "In Spotify auf die Playlist rechtsklicken → Teilen → Link kopieren. Album-, Titel- und Künstler-Links gehen genauso.",
            "en": "In Spotify right-click the playlist → Share → Copy link. Album, track and artist links work the same way."
          }
        },
        {
          "key": "shuffle",
          "type": "select",
          "label": {
            "de": "Zufallswiedergabe",
            "en": "Shuffle"
          },
          "default": "keep",
          "options": [
            {
              "value": "keep",
              "label": {
                "de": "Unverändert lassen",
                "en": "Leave as is"
              }
            },
            {
              "value": "on",
              "label": {
                "de": "Einschalten",
                "en": "Turn on"
              }
            },
            {
              "value": "off",
              "label": {
                "de": "Ausschalten",
                "en": "Turn off"
              }
            }
          ],
          "help": {
            "de": "Wird vor dem Start gesetzt. Spotify nimmt das über MPRIS nicht immer an — dann bleibt es beim bisherigen Modus.",
            "en": "Applied before starting. Spotify does not always accept this over MPRIS; the previous mode then stays."
          }
        }
      ]
    },
    {
      "id": "shuffle",
      "name": {
        "de": "Zufallswiedergabe",
        "en": "Shuffle"
      },
      "description": {
        "de": "Schaltet die Zufallswiedergabe ein oder aus.",
        "en": "Toggle shuffle mode on or off."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "arrows-shuffle",
      "states": [
        {
          "id": "on",
          "name": {
            "de": "An",
            "en": "On"
          },
          "default_icon": "arrows-shuffle"
        },
        {
          "id": "off",
          "name": {
            "de": "Aus",
            "en": "Off"
          },
          "default_icon": "arrows-right-left"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "repeat",
      "name": {
        "de": "Wiederholung",
        "en": "Repeat"
      },
      "description": {
        "de": "Schaltet zwischen aus, Playlist und einzelnem Titel um.",
        "en": "Cycle through repeat modes (off, playlist, single track)."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "repeat",
      "states": [
        {
          "id": "off",
          "name": {
            "de": "Aus",
            "en": "Off"
          },
          "default_icon": "repeat-off"
        },
        {
          "id": "playlist",
          "name": {
            "de": "Playlist",
            "en": "Playlist"
          },
          "default_icon": "repeat"
        },
        {
          "id": "track",
          "name": {
            "de": "Einzelner Titel",
            "en": "Single track"
          },
          "default_icon": "repeat-once"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "volume",
      "name": {
        "de": "Lautstärke",
        "en": "Volume"
      },
      "description": {
        "de": "Ändert die Lautstärke um einen einstellbaren Schritt.",
        "en": "Adjust volume by a custom step amount."
      },
      "inputs": [
        "dial",
        "key"
      ],
      "default_icon": "volume",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Normal",
            "en": "Normal"
          },
          "default_icon": "volume"
        },
        {
          "id": "muted",
          "name": {
            "de": "Stumm",
            "en": "Muted"
          },
          "default_icon": "volume-3"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "step",
          "type": "number",
          "label": {
            "de": "Schrittweite (%)",
            "en": "Step size (%)"
          },
          "default": 5,
          "min": 1,
          "max": 25
        },
        {
          "key": "direction",
          "type": "select",
          "label": {
            "de": "Auf einer Taste",
            "en": "On a key"
          },
          "default": "up",
          "options": [
            {
              "value": "up",
              "label": {
                "de": "Lauter",
                "en": "Louder"
              }
            },
            {
              "value": "down",
              "label": {
                "de": "Leiser",
                "en": "Quieter"
              }
            },
            {
              "value": "mute",
              "label": {
                "de": "Stumm schalten",
                "en": "Mute"
              }
            }
          ],
          "help": {
            "de": "Am Dial wird immer gedreht — diese Einstellung gilt nur für Tasten.",
            "en": "On a dial you simply turn it — this setting only applies to keys."
          }
        },
        {
          "key": "bar_color",
          "type": "color",
          "label": {
            "de": "Balkenfarbe",
            "en": "Bar colour"
          },
          "default": "#1db954"
        }
      ]
    },
    {
      "id": "multimedia",
      "name": {
        "de": "Multimedia",
        "en": "Multimedia"
      },
      "description": {
        "de": "Drücken startet/pausiert, Drehen springt zwischen Titeln oder regelt die Lautstärke.",
        "en": "Press to play/pause and rotate to skip tracks or adjust volume."
      },
      "inputs": [
        "dial"
      ],
      "default_icon": "player-play",
      "states": [
        {
          "id": "playing",
          "name": {
            "de": "Läuft",
            "en": "Playing"
          },
          "default_icon": "player-pause"
        },
        {
          "id": "paused",
          "name": {
            "de": "Pausiert",
            "en": "Paused"
          },
          "default_icon": "player-play"
        },
        {
          "id": "stopped",
          "name": {
            "de": "Gestoppt",
            "en": "Stopped"
          },
          "default_icon": "player-play"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verfügbar",
            "en": "Unavailable"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "rotate",
          "type": "select",
          "label": {
            "de": "Drehen bewirkt",
            "en": "Rotating does"
          },
          "default": "track",
          "options": [
            {
              "value": "track",
              "label": {
                "de": "Titel wechseln",
                "en": "Skip tracks"
              }
            },
            {
              "value": "volume",
              "label": {
                "de": "Lautstärke ändern",
                "en": "Adjust volume"
              }
            }
          ]
        },
        {
          "key": "step",
          "type": "number",
          "label": {
            "de": "Schrittweite Lautstärke (%)",
            "en": "Volume step (%)"
          },
          "default": 5,
          "min": 1,
          "max": 25,
          "depends_on": {
            "rotate": "volume"
          }
        },
        {
          "key": "show_art",
          "type": "bool",
          "label": {
            "de": "Albumbild als Hintergrund",
            "en": "Album art as background"
          },
          "default": true
        }
      ]
    }
  ]
}
