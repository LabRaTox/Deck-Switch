{
  "id": "weather",
  "name": {
    "de": "Wetter",
    "en": "Weather"
  },
  "version": "1.0.2",
  "type": "action",
  "author": "LabRaTox",
  "category": "monitoring",
  "accent": "#0ea5e9",
  "description": {
    "de": "Aktuelles Wetter, Vorhersage und Luftqualität auf Tasten und Dials — ohne Konto und ohne API-Schlüssel.",
    "en": "Current weather, forecast and air quality on keys and dials — no account, no API key."
  },
  "changelog": {
    "de": "1.0.2 — Nur innen drin: Das Plugin holt seine Hilfsdatei jetzt relativ. Damit können zwei Plugins Dateien gleich benennen, ohne sich gegenseitig auszubremsen.",
    "en": "1.0.2 — Under the hood only: the plugin now imports its helper file relatively, so two plugins can name files alike without getting in each other's way."
  },
  "license": "MIT",
  "support": "https://github.com/LabRaTox/Deck-Switch",
  "icon": "icon.png",
  "screenshots": [
    "screenshots/aktionen.png"
  ],
  "entry": "plugin.py",
  "class": "WeatherPlugin",
  "config_schema": [
    {
      "key": "search",
      "type": "text",
      "label": {
        "de": "Ort suchen",
        "en": "Search location"
      },
      "placeholder": {
        "de": "Stadt oder Postleitzahl",
        "en": "City or postal code"
      },
      "help": {
        "de": "Eintippen und darunter den Treffer auswählen.",
        "en": "Type here, then pick a match below."
      }
    },
    {
      "key": "location",
      "type": "select",
      "label": {
        "de": "Ort",
        "en": "Location"
      },
      "options_source": "locations",
      "options_depend_on": [
        "search"
      ]
    },
    {
      "key": "units",
      "type": "select",
      "label": {
        "de": "Einheiten",
        "en": "Units"
      },
      "default": "metric",
      "options": [
        {
          "value": "metric",
          "label": {
            "de": "°C, km/h",
            "en": "°C, km/h"
          }
        },
        {
          "value": "imperial",
          "label": {
            "de": "°F, mph",
            "en": "°F, mph"
          }
        }
      ]
    },
    {
      "key": "refresh_minutes",
      "type": "number",
      "label": {
        "de": "Aktualisierung (Minuten)",
        "en": "Refresh (minutes)"
      },
      "default": 10,
      "min": 5,
      "max": 120
    }
  ],
  "actions": [
    {
      "id": "current",
      "name": {
        "de": "Wetter",
        "en": "Weather"
      },
      "description": {
        "de": "Zeigt Temperatur und Bedingungen. Kurzer Druck blendet Höchst- und Tiefstwert ein; am Dial lässt sich durch den Tagesverlauf blättern.",
        "en": "Shows temperature and conditions. A short press reveals today's high and low; on a dial you can scroll through the day."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "sun",
      "states": [
        {
          "id": "ok",
          "name": {
            "de": "Aktuell",
            "en": "Current"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Keine Daten",
            "en": "No data"
          },
          "default_icon": "cloud-off"
        }
      ],
      "settings_schema": [
        {
          "key": "location_override",
          "type": "text",
          "label": {
            "de": "Abweichender Ort",
            "en": "Different location"
          },
          "placeholder": {
            "de": "leer = Ort aus den Plugin-Einstellungen",
            "en": "empty = location from plugin settings"
          },
          "help": {
            "de": "Stadt, Postleitzahl oder „Breite,Länge“ — für eine zweite Stadt auf einer anderen Taste.",
            "en": "City, postal code or “lat,lon” — for a second city on another key."
          }
        },
        {
          "key": "show",
          "type": "select",
          "label": {
            "de": "Anzeige",
            "en": "Display"
          },
          "default": "temp_condition",
          "options": [
            {
              "value": "temp",
              "label": {
                "de": "Nur Temperatur",
                "en": "Temperature only"
              }
            },
            {
              "value": "temp_condition",
              "label": {
                "de": "Temperatur und Wetterlage",
                "en": "Temperature and condition"
              }
            },
            {
              "value": "temp_location",
              "label": {
                "de": "Temperatur und Ort",
                "en": "Temperature and location"
              }
            },
            {
              "value": "high_low",
              "label": {
                "de": "Höchst- und Tiefstwert",
                "en": "High and low"
              }
            }
          ]
        },
        {
          "key": "dial_view",
          "type": "select",
          "label": {
            "de": "Dial-Ansicht",
            "en": "Dial view"
          },
          "default": "hourly",
          "options": [
            {
              "value": "hourly",
              "label": {
                "de": "Stundenverlauf",
                "en": "Hourly"
              }
            },
            {
              "value": "chart",
              "label": {
                "de": "Diagramm",
                "en": "Chart"
              }
            },
            {
              "value": "details",
              "label": {
                "de": "Details",
                "en": "Details"
              }
            }
          ],
          "help": {
            "de": "Am Dial: Drehen blättert, Drücken wechselt die Ansicht.",
            "en": "On a dial: turn to scroll, press to switch the view."
          }
        }
      ]
    },
    {
      "id": "forecast",
      "name": {
        "de": "Vorhersage",
        "en": "Forecast"
      },
      "description": {
        "de": "Vorhersage der nächsten Tage. Am Dial durch die Woche blättern, auf der Taste einen festen Tag anzeigen.",
        "en": "Forecast for the coming days. Scroll through the week on a dial, or show a fixed day on a key."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "calendar",
      "states": [
        {
          "id": "ok",
          "name": {
            "de": "Vorhersage",
            "en": "Forecast"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Keine Daten",
            "en": "No data"
          },
          "default_icon": "cloud-off"
        }
      ],
      "settings_schema": [
        {
          "key": "location_override",
          "type": "text",
          "label": {
            "de": "Abweichender Ort",
            "en": "Different location"
          },
          "placeholder": {
            "de": "leer = Ort aus den Plugin-Einstellungen",
            "en": "empty = location from plugin settings"
          }
        },
        {
          "key": "day",
          "type": "number",
          "label": {
            "de": "Tag (0 = heute)",
            "en": "Day (0 = today)"
          },
          "default": 1,
          "min": 0,
          "max": 6,
          "help": {
            "de": "Startwert; am Dial lässt sich davon ausgehend blättern.",
            "en": "Starting point; on a dial you can scroll from here."
          }
        },
        {
          "key": "show_rain",
          "type": "bool",
          "label": {
            "de": "Regenwahrscheinlichkeit anzeigen",
            "en": "Show chance of rain"
          },
          "default": true
        }
      ]
    },
    {
      "id": "air_quality",
      "name": {
        "de": "Luftqualität",
        "en": "Air quality"
      },
      "description": {
        "de": "Luftqualitätsindex mit Einstufung, dazu Feinstaubwerte.",
        "en": "Air quality index with severity guidance and particulate values."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "wind",
      "states": [
        {
          "id": "ok",
          "name": {
            "de": "Verfügbar",
            "en": "Available"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Keine Daten",
            "en": "No data"
          },
          "default_icon": "cloud-off"
        }
      ],
      "settings_schema": [
        {
          "key": "location_override",
          "type": "text",
          "label": {
            "de": "Abweichender Ort",
            "en": "Different location"
          },
          "placeholder": {
            "de": "leer = Ort aus den Plugin-Einstellungen",
            "en": "empty = location from plugin settings"
          }
        },
        {
          "key": "scale",
          "type": "select",
          "label": {
            "de": "Skala",
            "en": "Scale"
          },
          "default": "european",
          "options": [
            {
              "value": "european",
              "label": {
                "de": "Europäisch",
                "en": "European"
              }
            },
            {
              "value": "us",
              "label": {
                "de": "US",
                "en": "US"
              }
            }
          ]
        },
        {
          "key": "color_by_severity",
          "type": "bool",
          "label": {
            "de": "Farbe nach Einstufung",
            "en": "Colour by severity"
          },
          "default": true
        }
      ]
    }
  ]
}
