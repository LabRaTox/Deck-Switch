{
  "id": "clocks",
  "name": {
    "de": "Clocks",
    "en": "Clocks"
  },
  "version": "1.1.0",
  "min_app_version": "1.4.0",
  "type": "action",
  "author": "LabRaTox",
  "category": "utilities",
  "accent": "#14b8a6",
  "description": {
    "de": "Uhren auf Tasten und Dials: die eigene Uhrzeit und eine Weltuhr mit bis zu sechs Zonen. Analog oder digital, 22 Zifferblätter, 9 Farbschemata oder eigene Farben, 12 oder 24 Stunden, Datum und Wochentag. Am Dial ein eingebauter Editor und ein Countdown.",
    "en": "Clocks on keys and dials: your own time and a world clock with up to six zones. Analog or digital, 22 clock faces, 9 colour schemes or your own colours, 12- or 24-hour, date and weekday. On a dial, a built-in editor and a countdown."
  },
  "changelog": {
    "de": "Die Texte des Plugins folgen jetzt der eingestellten Sprache. Braucht DECK//SWITCH 1.4.0 oder neuer.",
    "en": "The plugin's texts now follow the language setting. Needs DECK//SWITCH 1.4.0 or newer."
  },
  "license": "MIT",
  "support": "https://github.com/LabRaTox/Deck-Switch",
  "icon": "icon.png",
  "screenshots": [
    "screenshots/uhren.png",
    "screenshots/dials.png"
  ],
  "entry": "plugin.py",
  "class": "ClocksPlugin",
  "actions": [
    {
      "id": "my_clock",
      "name": {
        "de": "Meine Uhr",
        "en": "My Clock"
      },
      "description": {
        "de": "Eine Uhr in der Systemzeit oder einer gewählten Zone. Taste: Drücken zeigt Datum und Zone. Dial: Drehen wechselt das Zifferblatt, Drücken öffnet den Editor samt Countdown, Tippen schaltet zwischen analog und digital.",
        "en": "A clock in system time or a chosen zone. Key: press to show date and zone. Dial: turn to change the face, push to open the editor with a countdown, tap to switch between analog and digital."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "clock",
      "settings_schema": [
        {
          "key": "timezone",
          "type": "select",
          "label": {
            "de": "Zeitzone",
            "en": "Time zone"
          },
          "default": "",
          "options_source": "zones",
          "help": {
            "de": "Leer heißt Systemzeit. Am Dial lässt sich die Zone auch im Editor wechseln.",
            "en": "Empty means system time. On a dial the zone can also be changed in the editor."
          }
        },
        {
          "key": "place_name",
          "type": "text",
          "label": {
            "de": "Ortsname",
            "en": "Place name"
          },
          "placeholder": {
            "de": "leer = Stadt der Zeitzone",
            "en": "empty = city of the time zone"
          }
        },
        {
          "key": "display",
          "type": "select",
          "label": {
            "de": "Anzeige",
            "en": "Display"
          },
          "default": "analog",
