[Unit]
Description=DECK//SWITCH Backend
Documentation=https://github.com/LabRaTox/Deck-Switch
# Erst starten, wenn die grafische Sitzung steht: die udev-Regel vergibt den
# Gerätezugriff per uaccess an den eingeloggten User.
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
# Endet das Backend sofort wieder, etwa weil Port 8770 schon belegt ist, hört
# systemd nach fünf Versuchen auf, statt alle fünf Sekunden neu zu starten.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# __REPO__ wird von scripts/install-service.sh bzw. dem Schalter in den
# Einstellungen durch den echten Pfad ersetzt.
WorkingDirectory=__REPO__
# In Anführungszeichen, damit ein Pfad mit Leerzeichen ganz bleibt.
ExecStart="__REPO__/.venv/bin/python" -m deckswitch
Restart=on-failure
RestartSec=5
# Das Deck kann beim Login noch nicht bereit sein — die Runtime wartet selbst
# darauf, ein Absturz wäre also ein echter Fehler und kein Normalfall.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
