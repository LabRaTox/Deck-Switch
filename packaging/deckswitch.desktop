[Desktop Entry]
Type=Application
Name=DECK//SWITCH
GenericName=Stream Deck control
GenericName[de]=Stream-Deck-Steuerung
Comment=Configure and control your Elgato Stream Deck
Comment[de]=Das Elgato Stream Deck einrichten und steuern
# Der Platzhalter unten wird beim Installieren ersetzt — von
# scripts/install-desktop-entry.sh oder vom PKGBUILD.
Exec=__EXEC__
Icon=deckswitch
Terminal=false
# Nur eine Hauptkategorie: Mit Utility und Settings zugleich taucht der
# Eintrag in manchen Menüs doppelt auf (desktop-file-validate meckert es
# auch an). Utility, weil das hier ein Programm ist und keine
# Systemeinstellung.
Categories=Utility;
Keywords=streamdeck;elgato;deck;macro;
StartupNotify=true
# Am 2026-09-07 am laufenden Fenster abgelesen (`xprop WM_CLASS` unter
# XWayland): "deckswitch", "Deckswitch". Ohne diese Zeile ordnet die
# Fensterleiste dem Fenster kein Symbol zu. Unter nativem Wayland zählt
# statt WM_CLASS die App-ID; die ist ungeprüft, schadet hier aber nicht —
# steht sie falsch, greift bloß die Zuordnung nicht, die es vorher auch
# nicht gab.
StartupWMClass=deckswitch
