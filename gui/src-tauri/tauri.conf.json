{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DeckSwitch",
  "mainBinaryName": "deckswitch",
  "identifier": "app.labratox.deckswitch",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DECK//SWITCH",
        "width": 1760,
        "height": 980,
        "minWidth": 1400,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Control software for the Elgato Stream Deck+",
    "longDescription": "DECK//SWITCH — standalone control software for the Elgato Stream Deck+ on CachyOS and Arch Linux, with its own plugin system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
