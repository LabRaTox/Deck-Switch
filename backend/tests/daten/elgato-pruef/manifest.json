{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "de.labratox.pruef",
  "Name": "Prüfzähler",
  "Version": "1.0.0.0",
  "Author": "LabRaTox",
  "Description": "Zählt Tastendrücke. Nur zum Prüfen der Brücke.",
  "Category": "Test",
  "Icon": "imgs/plugin",
  "CodePath": "plugin.js",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Zähler",
      "UUID": "de.labratox.pruef.zaehler",
      "Icon": "imgs/plugin",
      "Tooltip": "Zählt jeden Druck",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/plugin"
        },
        {
          "Image": "imgs/plugin"
        }
      ],
      "PropertyInspectorPath": "ui/einstellungen.html",
      "Encoder": {
        "layout": "layouts/zaehler.json",
        "TriggerDescription": {
          "Rotate": "Zählen",
          "Push": "Zurücksetzen"
        }
      }
    }
  ]
}
