{
  "id": "obs",
  "name": "OBS",
  "version": "2.0.0",
  "type": "action",
  "entry": "plugin.py",
  "class": "ObsPlugin",
  "accent": "#ef4444",
  "description": {
    "de": "Steuert OBS Studio über obs-websocket: Szenen, Stream, Aufnahme, Quellen, Filter und mehr.",
    "en": "Controls OBS Studio via obs-websocket: scenes, stream, recording, sources, filters and more."
  },
  "config_schema": [
    {
      "key": "host",
      "type": "text",
      "label": {
        "de": "Host",
        "en": "Host"
      },
      "default": "127.0.0.1"
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "de": "Port",
        "en": "Port"
      },
      "default": 4455,
      "min": 1,
      "max": 65535
    },
    {
      "key": "password",
      "type": "password",
      "label": {
        "de": "Passwort",
        "en": "Password"
      },
      "default": "",
      "help": {
        "de": "In OBS unter Werkzeuge → WebSocket-Servereinstellungen.",
        "en": "In OBS under Tools → WebSocket Server Settings."
      }
    },
    {
      "key": "screenshot_dir",
      "type": "path",
      "label": {
        "de": "Ordner für Screenshots",
        "en": "Screenshot folder"
      },
      "default": "~/Bilder/OBS",
      "help": {
        "de": "Wird bei Bedarf angelegt.",
        "en": "Created if missing."
      }
    },
    {
      "key": "auto_connect",
      "type": "bool",
      "label": {
        "de": "Automatisch verbinden",
        "en": "Connect automatically"
      },
      "default": true
    }
  ],
  "actions": [
    {
      "id": "record",
      "name": {
        "de": "Aufnahme",
        "en": "Record"
      },
      "description": {
        "de": "Startet oder stoppt die Aufnahme.",
        "en": "Start or stop recording."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-record",
      "states": [
        {
          "id": "on",
          "name": {
            "de": "Läuft",
            "en": "Recording"
          },
          "default_icon": "player-stop"
        },
        {
          "id": "paused",
          "name": {
            "de": "Pausiert",
            "en": "Paused"
          },
          "default_icon": "player-pause"
        },
        {
          "id": "off",
          "name": {
            "de": "Aus",
            "en": "Off"
          },
          "default_icon": "player-record"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verbunden",
            "en": "Disconnected"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "show_time",
          "type": "bool",
          "label": {
            "de": "Laufzeit anzeigen",
            "en": "Show duration"
          },
          "default": true
        },
        {
          "key": "confirm",
          "type": "bool",
          "label": {
            "de": "Zweimal drücken zum Stoppen",
            "en": "Press twice to stop"
          },
          "default": false
        }
      ]
    },
    {
      "id": "record_pause",
      "name": {
        "de": "Aufnahme pausieren",
        "en": "Record pause"
      },
      "description": {
        "de": "Pausiert eine laufende Aufnahme oder setzt sie fort.",
        "en": "Pause an active recording or resume it."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-pause",
      "states": [
        {
          "id": "paused",
          "name": {
            "de": "Pausiert",
            "en": "Paused"
          },
          "default_icon": "player-play"
        },
        {
          "id": "recording",
          "name": {
            "de": "Läuft",
            "en": "Recording"
          },
          "default_icon": "player-pause"
        },
        {
          "id": "idle",
          "name": {
            "de": "Keine Aufnahme",
            "en": "Not recording"
          }
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verbunden",
            "en": "Disconnected"
          }
        }
      ],
      "settings_schema": []
    },
    {
      "id": "stream",
      "name": {
        "de": "Stream",
        "en": "Stream"
      },
      "description": {
        "de": "Startet oder stoppt den Stream.",
        "en": "Start or stop streaming."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "broadcast",
      "states": [
        {
          "id": "on",
          "name": {
            "de": "Live",
            "en": "Live"
          },
          "default_icon": "broadcast"
        },
        {
          "id": "off",
          "name": {
            "de": "Aus",
            "en": "Off"
          },
          "default_icon": "broadcast-off"
        },
        {
          "id": "offline",
          "name": {
            "de": "Nicht verbunden",
            "en": "Disconnected"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "show_time",
          "type": "bool",
          "label": {
            "de": "Laufzeit anzeigen",
            "en": "Show duration"
          },
          "default": true
        },
        {
          "key": "confirm",
          "type": "bool",
          "label": {
            "de": "Zweimal drücken zum Stoppen",
            "en": "Press twice to stop"
          },
          "default": true
        }
      ]
    },
    {
      "id": "replay_buffer",
