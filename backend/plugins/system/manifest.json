{
  "id": "system",
  "name": {
    "de": "System",
    "en": "System"
  },
  "version": "1.0.0",
  "type": "action",
  "entry": "plugin.py",
  "class": "SystemPlugin",
  "accent": "#0ea5e9",
  "description": {
    "de": "Programme starten, Dateien und Links öffnen, Systemwerte anzeigen, Monitorhelligkeit regeln.",
    "en": "Launch programs, open files and links, show system metrics, control display brightness."
  },
  "config_schema": [
    {
      "key": "temperature_unit",
      "type": "select",
      "label": {
        "de": "Temperatureinheit",
        "en": "Temperature unit"
      },
      "default": "celsius",
      "options": [
        {
          "value": "celsius",
          "label": {
            "de": "Celsius (°C)",
            "en": "Celsius (°C)"
          }
        },
        {
          "value": "fahrenheit",
          "label": {
            "de": "Fahrenheit (°F)",
            "en": "Fahrenheit (°F)"
          }
        }
      ],
      "help": {
        "de": "Gilt für alle Temperaturanzeigen dieses Plugins. Das Wetter-Plugin hat eine eigene Einstellung.",
        "en": "Applies to every temperature this plugin shows. The weather plugin has its own setting."
      }
    }
  ],
  "actions": [
    {
      "id": "launch",
      "name": {
        "de": "Programm starten",
        "en": "Launch program"
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "rocket",
      "settings_schema": [
        {
          "key": "command",
          "type": "text",
          "label": {
            "de": "Befehl",
            "en": "Command"
          },
          "placeholder": "obs",
          "help": {
            "de": "Wird ohne Shell ausgeführt; Argumente mit Leerzeichen trennen.",
            "en": "Executed without a shell; separate arguments with spaces."
          }
        },
        {
          "key": "working_dir",
          "type": "path",
          "label": {
            "de": "Arbeitsverzeichnis",
            "en": "Working directory"
          },
          "default": ""
        },
        {
          "key": "single_instance",
          "type": "bool",
          "label": {
            "de": "Nicht erneut starten, wenn es schon läuft",
            "en": "Do not start again if already running"
          },
          "default": false
        }
      ]
    },
    {
      "id": "open_folder",
      "name": {
        "de": "Ordner öffnen",
        "en": "Open folder"
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "folder-open",
      "settings_schema": [
        {
          "key": "path",
          "type": "path",
          "label": {
            "de": "Pfad",
            "en": "Path"
          },
          "placeholder": "~/Videos"
        }
      ]
    },
    {
      "id": "open_file",
      "name": {
        "de": "Datei öffnen",
        "en": "Open file"
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "file",
      "settings_schema": [
        {
          "key": "path",
          "type": "file",
          "label": {
            "de": "Datei",
            "en": "File"
          }
        }
      ]
    },
    {
      "id": "open_url",
      "name": {
        "de": "Link öffnen",
        "en": "Open link"
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "world",
      "settings_schema": [
        {
          "key": "url",
          "type": "text",
          "label": "URL",
          "placeholder": "https://"
        }
      ]
    },
    {
      "id": "run_script",
      "name": {
        "de": "Shell-Befehl",
        "en": "Shell command"
      },
      "description": {
        "de": "Führt eine Befehlszeile in der Shell aus.",
        "en": "Runs a command line in the shell."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "terminal-2",
      "settings_schema": [
        {
          "key": "command",
          "type": "text",
          "label": {
            "de": "Befehlszeile",
            "en": "Command line"
          },
          "placeholder": "notify-send 'Hallo'"
        },
        {
          "key": "shell",
          "type": "select",
          "label": "Shell",
          "default": "fish",
          "options": [
            {
              "value": "fish",
              "label": "fish"
            },
            {
              "value": "bash",
              "label": "bash"
            },
            {
              "value": "sh",
              "label": "sh"
            }
          ]
        }
      ]
    },
    {
      "id": "monitor",
      "name": {
        "de": "Systemwert",
        "en": "System monitor"
      },
      "description": {
        "de": "Zeigt CPU, RAM, GPU, Temperaturen oder Netzdurchsatz — auf einem Dial mit Balken.",
        "en": "Shows CPU, RAM, GPU, temperatures or network throughput — with a bar on a dial."
      },
      "inputs": [
        "dial",
        "key"
      ],
      "default_icon": "activity",
      "settings_schema": [
        {
          "key": "metric",
          "type": "select",
          "label": {
            "de": "Messwert",
            "en": "Metric"
          },
          "default": "cpu",
          "options": [
            {
              "value": "cpu",
              "label": {
                "de": "CPU-Auslastung",
                "en": "CPU usage"
              }
            },
            {
              "value": "cpu_temp",
              "label": {
                "de": "CPU-Temperatur",
                "en": "CPU temperature"
              }
            },
            {
              "value": "memory",
              "label": {
                "de": "Arbeitsspeicher",
                "en": "Memory"
              }
            },
            {
              "value": "swap",
              "label": {
                "de": "Auslagerung",
                "en": "Swap"
              }
            },
            {
              "value": "gpu",
              "label": {
                "de": "GPU-Auslastung",
                "en": "GPU usage"
              }
            },
            {
              "value": "gpu_temp",
              "label": {
                "de": "GPU-Temperatur",
                "en": "GPU temperature"
              }
            },
            {
              "value": "gpu_memory",
              "label": {
                "de": "Grafikspeicher",
                "en": "VRAM"
              }
            },
            {
              "value": "nvme_temp",
              "label": {
                "de": "SSD-Temperatur",
                "en": "SSD temperature"
              }
            },
            {
              "value": "disk",
              "label": {
                "de": "Speicherplatz",
                "en": "Disk space"
              }
            },
            {
              "value": "net_down",
              "label": {
                "de": "Netz empfangen",
                "en": "Network down"
              }
            },
            {
              "value": "net_up",
              "label": {
                "de": "Netz gesendet",
                "en": "Network up"
              }
            }
          ],
          "help": {
            "de": "GPU-Werte kommen von nvidia-smi und stehen nur mit NVIDIA-Karte zur Verfügung.",
            "en": "GPU values come from nvidia-smi and need an NVIDIA card."
          }
        },
        {
          "key": "interface",
          "type": "select",
          "label": {
            "de": "Netzwerkschnittstelle",
            "en": "Network interface"
          },
          "options_source": "interfaces",
          "depends_on": {
            "metric": [
              "net_down",
              "net_up"
            ]
          }
        },
        {
          "key": "path",
          "type": "path",
          "label": {
            "de": "Pfad",
            "en": "Path"
          },
          "default": "/",
          "depends_on": {
            "metric": "disk"
          }
        },
        {
          "key": "show_name",
          "type": "bool",
          "label": {
            "de": "Kürzel vor dem Wert",
            "en": "Prefix with a short name"
          },
          "default": true
        },
        {
          "key": "show_bar",
          "type": "bool",
          "label": {
            "de": "Balken anzeigen",
            "en": "Show bar"
          },
          "default": true
        },
        {
          "key": "bar_color",
          "type": "color",
          "label": {
            "de": "Balkenfarbe",
            "en": "Bar colour"
          },
          "default": "",
          "help": {
            "de": "Leer lassen: Der Balken wird ab 75 % gelb und ab 90 % rot.",
            "en": "Leave empty: the bar turns amber above 75% and red above 90%."
          }
        }
      ]
    },
    {
      "id": "display_brightness",
      "name": {
        "de": "Monitorhelligkeit",
        "en": "Display brightness"
      },
      "description": {
        "de": "Regelt die Helligkeit am Monitor selbst über DDC/CI.",
        "en": "Adjusts brightness on the monitor itself over DDC/CI."
      },
      "inputs": [
        "dial",
        "key"
      ],
      "default_icon": "brightness-up",
      "settings_schema": [
        {
          "key": "display",
          "type": "select",
          "label": {
            "de": "Monitor",
            "en": "Display"
          },
          "options_source": "displays",
          "help": {
            "de": "Nicht jeder Monitor lässt DDC/CI zu — viele muss man im Bildschirmmenü erst freischalten.",
            "en": "Not every monitor allows DDC/CI — many need it enabled in their on-screen menu first."
          }
        },
        {
          "key": "step",
          "type": "number",
          "label": {
            "de": "Schrittweite (%)",
            "en": "Step size (%)"
          },
          "default": 5,
          "min": 1,
          "max": 25
        },
        {
          "key": "preset_low",
          "type": "number",
          "label": {
            "de": "Druck: dunkler Wert (%)",
            "en": "Press: dark value (%)"
          },
          "default": 20,
          "min": 0,
          "max": 100
        },
        {
          "key": "preset_high",
          "type": "number",
          "label": {
            "de": "Druck: heller Wert (%)",
            "en": "Press: bright value (%)"
          },
          "default": 80,
          "min": 0,
          "max": 100
        },
        {
          "key": "show_bar",
          "type": "bool",
          "label": {
            "de": "Balken anzeigen",
            "en": "Show bar"
          },
          "default": true
        },
        {
          "key": "bar_color",
          "type": "color",
          "label": {
            "de": "Balkenfarbe",
            "en": "Bar colour"
          },
          "default": "#0ea5e9"
        }
      ]
    },
    {
      "id": "hotkey",
      "name": {
        "de": "Tastenkombination",
        "en": "Hotkey"
      },
      "description": {
        "de": "Schickt eine Tastenkombination an das Programm im Vordergrund.",
        "en": "Sends a key combination to the focused application."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "keyboard",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Bereit",
            "en": "Idle"
          }
        },
        {
          "id": "held",
          "name": {
            "de": "Gedrückt",
            "en": "Held"
          },
          "default_icon": "keyboard-show"
        }
      ],
      "settings_schema": [
        {
          "key": "combo",
          "type": "hotkey",
          "label": {
            "de": "Tastenkombination",
            "en": "Key combination"
          },
          "placeholder": "Strg+Shift+F5",
          "help": {
            "de": "Aufnehmen anklicken und die Kombination drücken.",
            "en": "Click record and press the combination."
          }
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "de": "Verhalten",
            "en": "Behaviour"
          },
          "default": "tap",
          "options": [
            {
              "value": "tap",
              "label": {
                "de": "Einmal tippen",
                "en": "Tap once"
              }
            },
            {
              "value": "hold",
              "label": {
                "de": "Halten, solange die Taste gedrückt ist",
                "en": "Hold while the key is down"
              }
            }
          ],
          "help": {
            "de": "Halten eignet sich für Push-to-Talk.",
            "en": "Hold suits push-to-talk."
          }
        }
      ]
    },
    {
      "id": "hotkey_switch",
      "name": {
        "de": "Tastenkombination (Umschalter)",
        "en": "Hotkey switch"
      },
      "description": {
        "de": "Zwei Kombinationen im Wechsel — hin und zurück.",
        "en": "Two combinations, alternating."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "switch-horizontal",
      "states": [
        {
          "id": "a",
          "name": {
            "de": "Erste",
            "en": "First"
          }
        },
        {
          "id": "b",
          "name": {
            "de": "Zweite",
            "en": "Second"
          }
        }
      ],
      "settings_schema": [
        {
          "key": "combo_a",
          "type": "hotkey",
          "label": {
            "de": "Erste Kombination",
            "en": "First combination"
          }
        },
        {
          "key": "combo_b",
          "type": "hotkey",
          "label": {
            "de": "Zweite Kombination",
            "en": "Second combination"
          }
        }
      ]
    },
    {
      "id": "text",
      "name": {
        "de": "Text tippen",
        "en": "Type text"
      },
      "description": {
        "de": "Tippt einen hinterlegten Text — Textbaustein auf Knopfdruck.",
        "en": "Types a stored text — a snippet at the push of a key."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "text-caption",
      "settings_schema": [
        {
          "key": "text",
          "type": "text",
          "label": {
            "de": "Text",
            "en": "Text"
          },
          "help": {
            "de": "Wird Zeichen für Zeichen über die eingestellte Tastaturbelegung getippt.",
            "en": "Typed character by character using the active keyboard layout."
          }
        },
        {
          "key": "enter_after",
          "type": "bool",
          "label": {
            "de": "Mit Eingabetaste abschließen",
            "en": "Press Enter afterwards"
          },
          "default": false
        },
        {
          "key": "delay_ms",
          "type": "number",
          "label": {
            "de": "Pause je Zeichen (ms)",
            "en": "Delay per character (ms)"
          },
          "default": 12,
          "min": 0,
          "max": 200,
          "step": 1,
          "help": {
            "de": "Manche Programme verschlucken zu schnelle Eingaben.",
            "en": "Some applications drop input that arrives too fast."
          }
        }
      ]
    },
    {
      "id": "multimedia",
      "name": {
        "de": "Multimedia",
        "en": "Multimedia"
      },
      "description": {
        "de": "Steuert den Player, der gerade spielt (MPRIS).",
        "en": "Controls whichever player is currently playing (MPRIS)."
      },
      "inputs": [
        "key",
        "dial"
      ],
      "default_icon": "player-play",
      "states": [
        {
          "id": "playing",
          "name": {
            "de": "Spielt",
            "en": "Playing"
          },
          "default_icon": "player-pause"
        },
        {
          "id": "paused",
          "name": {
            "de": "Pausiert",
            "en": "Paused"
          },
          "default_icon": "player-play"
        }
      ],
      "settings_schema": [
        {
          "key": "command",
          "type": "select",
          "label": {
            "de": "Aktion",
            "en": "Action"
          },
          "default": "play_pause",
          "options": [
            {
              "value": "play_pause",
              "label": {
                "de": "Wiedergabe / Pause",
                "en": "Play / pause"
              }
            },
            {
              "value": "next",
              "label": {
                "de": "Nächster Titel",
                "en": "Next track"
              }
            },
            {
              "value": "previous",
              "label": {
                "de": "Vorheriger Titel",
                "en": "Previous track"
              }
            },
            {
              "value": "stop",
              "label": {
                "de": "Anhalten",
                "en": "Stop"
              }
            },
            {
              "value": "play",
              "label": {
                "de": "Wiedergabe",
                "en": "Play"
              }
            },
            {
              "value": "pause",
              "label": {
                "de": "Pause",
                "en": "Pause"
              }
            }
          ]
        },
        {
          "key": "player",
          "type": "select",
          "label": {
            "de": "Player",
            "en": "Player"
          },
          "options_source": "players",
          "help": {
            "de": "Automatisch nimmt den Player, der gerade spielt.",
            "en": "Automatic picks whichever player is playing."
          }
        },
        {
          "key": "show_title",
          "type": "bool",
          "label": {
            "de": "Titel anzeigen",
            "en": "Show title"
          },
          "default": false
        }
      ]
    },
    {
      "id": "power",
      "name": {
        "de": "Sitzung",
        "en": "Session"
      },
      "description": {
        "de": "Sperren, abmelden, ruhen, neu starten, ausschalten.",
        "en": "Lock, log out, suspend, reboot, shut down."
      },
      "inputs": [
        "key"
      ],
      "default_icon": "power",
      "states": [
        {
          "id": "default",
          "name": {
            "de": "Bereit",
            "en": "Idle"
          }
        },
        {
          "id": "armed",
          "name": {
            "de": "Wartet auf Bestätigung",
            "en": "Waiting for confirmation"
          },
          "default_icon": "alert-triangle"
        }
      ],
      "settings_schema": [
        {
          "key": "command",
          "type": "select",
          "label": {
            "de": "Aktion",
            "en": "Action"
          },
          "default": "lock",
          "options": [
            {
              "value": "lock",
              "label": {
                "de": "Bildschirm sperren",
                "en": "Lock screen"
              }
            },
            {
              "value": "screen_off",
              "label": {
                "de": "Bildschirme ausschalten",
                "en": "Turn displays off"
              }
            },
            {
              "value": "screen_on",
              "label": {
                "de": "Bildschirme einschalten",
                "en": "Turn displays on"
              }
            },
            {
              "value": "suspend",
              "label": {
                "de": "Bereitschaft",
                "en": "Suspend"
              }
            },
            {
              "value": "hibernate",
              "label": {
                "de": "Ruhezustand",
                "en": "Hibernate"
              }
            },
            {
              "value": "logout_prompt",
              "label": {
                "de": "Abmelden (mit Rückfrage)",
                "en": "Log out (with prompt)"
              }
            },
            {
              "value": "logout",
              "label": {
                "de": "Abmelden (sofort)",
                "en": "Log out (immediately)"
              }
            },
            {
              "value": "reboot_prompt",
              "label": {
                "de": "Neu starten (mit Rückfrage)",
                "en": "Reboot (with prompt)"
              }
            },
            {
              "value": "reboot",
              "label": {
                "de": "Neu starten (sofort)",
                "en": "Reboot (immediately)"
              }
            },
            {
              "value": "poweroff_prompt",
              "label": {
                "de": "Ausschalten (mit Rückfrage)",
                "en": "Shut down (with prompt)"
              }
            },
            {
              "value": "poweroff",
              "label": {
                "de": "Ausschalten (sofort)",
                "en": "Shut down (immediately)"
              }
            }
          ]
        },
        {
          "key": "confirm",
          "type": "bool",
          "label": {
            "de": "Zweimal drücken",
            "en": "Press twice"
          },
          "default": true,
          "help": {
            "de": "Der erste Druck macht nur scharf — gegen Fehlgriffe.",
            "en": "The first press only arms the key — against mishaps."
          }
        }
      ]
    },
    {
      "id": "screenshot",
      "name": {
        "de": "Bildschirmfoto",
        "en": "Screenshot"
      },
      "description": {
        "de": "Nimmt ein Bildschirmfoto auf (Spectacle).",
        "en": "Takes a screenshot (Spectacle)."
      },
      "inputs": [
        "key"
      ],
      "default_icon": "camera",
      "settings_schema": [
        {
          "key": "mode",
          "type": "select",
          "label": {
            "de": "Ausschnitt",
            "en": "Area"
          },
          "default": "fullscreen",
          "options": [
            {
              "value": "fullscreen",
              "label": {
                "de": "Alle Bildschirme",
                "en": "All screens"
              }
            },
            {
              "value": "current",
              "label": {
                "de": "Aktueller Bildschirm",
                "en": "Current screen"
              }
            },
            {
              "value": "window",
              "label": {
                "de": "Aktives Fenster",
                "en": "Active window"
              }
            },
            {
              "value": "region",
              "label": {
                "de": "Bereich auswählen",
                "en": "Select a region"
              }
            }
          ]
        },
        {
          "key": "clipboard",
          "type": "bool",
          "label": {
            "de": "In die Zwischenablage statt in eine Datei",
            "en": "To clipboard instead of a file"
          },
          "default": false
        },
        {
          "key": "directory",
          "type": "path",
          "label": {
            "de": "Zielordner",
            "en": "Target folder"
          },
          "default": "",
          "depends_on": {
            "clipboard": false
          },
          "help": {
            "de": "Leer = Bilder/Screenshots.",
            "en": "Empty = Pictures/Screenshots."
          }
        },
        {
          "key": "delay_ms",
          "type": "number",
          "label": {
            "de": "Verzögerung (ms)",
            "en": "Delay (ms)"
          },
          "default": 0,
          "min": 0,
          "max": 10000,
          "step": 100
        }
      ]
    },
    {
      "id": "close_app",
      "name": {
        "de": "Programm beenden",
        "en": "Close program"
      },
      "description": {
        "de": "Beendet ein laufendes Programm.",
        "en": "Terminates a running program."
      },
      "inputs": [
        "key"
      ],
      "default_icon": "square-x",
      "settings_schema": [
        {
          "key": "pattern",
          "type": "text",
          "label": {
            "de": "Programm",
            "en": "Program"
          },
